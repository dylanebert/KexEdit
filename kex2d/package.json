{
    "name": "kex2d",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "bin": {
        "kex2d": "./src/cli.ts"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "cli": "bun run src/cli.ts",
        "test": "bun test",
        "capture": "bun run harness/capture.ts",
        "harness:deps": "[ -d harness/node_modules/@playwright/test ] || bun install --cwd harness --frozen-lockfile",
        "mutate": "bun run harness/mutate.ts",
        "freshness": "bun run harness/capture.ts -- -g \"__kex hook freshness\"",
        "trend": "bun run harness/trend.ts",
        "check": "bun run harness:deps && bun run format && tsc && svelte-check && biome check",
        "format": "biome check --write"
    },
    "dependencies": {
        "@dylanebert/shallot": "^0.9.4",
        "svelte": "^5.56.10"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.10",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@types/bun": "latest",
        "@typescript/native": "npm:typescript@7",
        "@webgpu/types": "^0.1.72",
        "svelte-check": "^4.7.6",
        "typescript": "~6",
        "unplugin-typegpu": "~0.11.6",
        "vite": "^8.2.2"
    }
}
