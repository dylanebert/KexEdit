{
    "name": "kex2d",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "bun test",
        "capture": "bun run harness/capture.ts",
        "harness:deps": "[ -d harness/node_modules/@playwright/test ] || bun install --cwd harness --frozen-lockfile",
        "check": "bun run harness:deps && bun run format && tsc && svelte-check && biome check",
        "format": "biome check --write"
    },
    "dependencies": {
        "@dylanebert/shallot": "^0.4.0",
        "svelte": "^5.19.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.6",
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
        "@types/bun": "latest",
        "@webgpu/types": "^0.1.0",
        "svelte-check": "^4.7.3",
        "typescript": "6.0.3",
        "unplugin-typegpu": "~0.11.6",
        "vite": "^8.0.0"
    }
}
